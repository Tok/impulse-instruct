/target
/dist
/models/*.gguf
/models/*.bin
.env
*.swp
.llama-src
.llama-src-official
.llama-official-build
llama-server.log
settings.json
session.json
# User-saved project snapshots (File → Save project writes these).
project-*.json
cobertura.xml
.claude/
/demo/output/
/demo/tts_cache/
# Runtime-generated subtitle playlist used by the demo recorder.
/demo/.narration_playlist
.tts-venv/
.neutts-venv/
voices/*.wav
# User-dropped sample packs (see samples/README.md).  The dir + README
# + .gitkeep stubs are tracked; the .wav contents are not.
samples/**/*.wav
samples/**/*.WAV
# `download-samples.sh` clones full SFZ libraries (Salamander, SSO,
# VSCO-2-CE, …) into `samples/instruments/<pack>/` — those can run
# multiple GB and don't belong in the tree.  The `starter/` folder
# stays tracked (curated placeholder; carries a .gitkeep) so the
# directory structure survives a fresh clone.
samples/instruments/*/
!samples/instruments/starter/
